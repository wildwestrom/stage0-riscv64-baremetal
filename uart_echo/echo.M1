# UART echo program in M1 format.
# Chain: M0 -> hex2 -> binary

# This program echoes characters received on UART back to the sender.
# UART base: 0x10000000, LSR: 0x10000005
#
# Concatenate `baremetal/riscv64_defs.M1` just before this file before sending to the assembler.

# Audited by Christian Westrom: 2026-03-17, 02:44 UTC
# My reasoning is that because M2-planet and all its code was
# hand-written. I can safely say that the opcodes are exactly
# what they are labeled. I have not verified this myself.

:_start
    # Stack setup (sp = 0x80002220)
    # Built via: lui 0x40, addiw 1, slli 13, addi 0x220
    ~0x00040000 RD_SP LUI        ; sp = 0x00040000
    !1 RD_SP RS1_SP ADDIW        ; sp = 0x00040001
    !13 RD_SP RS1_SP SLLI        ; sp = 0x80002000
    !0x220 RD_SP RS1_SP ADDI     ; sp = 0x80002220

    # UART address setup
    ~0x10000000 RD_A1 LUI        ; a1 = UART base
    ~0x10000000 RD_A2 LUI        ; a2 = UART base
    !5 RD_A2 RS1_A2 ADDIW        ; a2 = UART LSR

:echo_loop
    # Poll LSR bit 0 (Data Ready)
    RD_A0 RS1_A2 LB              ; lb a0, 0(a2)
    !1 RD_A0 RS1_A0 ANDI         ; andi a0, a0, 1

		# Try again if not ready
    @echo_loop RS1_A0 RS2_X0 BEQ ; beq a0, x0, echo_loop

    # Data ready, read from RBR
    RD_A0 RS1_A1 LB              ; lb a0, 0(a1)

:wait_tx
    # Wait for TX ready (bit 5 of LSR)
    RD_A3 RS1_A2 LB              ; lb a3, 0(a2)
    !0x20 RD_A3 RS1_A3 ANDI      ; andi a3, a3, 0x20

		# Not ready, try again
    @wait_tx RS1_A3 RS2_X0 BEQ   ; beq a3, x0, wait_tx

    # Ready: Echo the character
    RS1_A1 RS2_A0 SB             ; sb a0, 0(a1)

    # Loop forever
    $echo_loop RD_X0 JAL         ; jal x0, echo_loop
