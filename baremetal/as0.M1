# Self-hosting assembler payload for M0.
# Source of truth for the bootstrap path; `baremetal/GAS/as0.s` is kept as
# a reference listing input with matching intent comments.
#
# Concatenate `baremetal/riscv64_defs.M1` immediately before this file before
# sending it to M0.

DEFINE WORK_BASE 0x80100000
DEFINE SOURCE_BASE 0x80200000
DEFINE SOURCE_MAX 0x20000
DEFINE STACK_TOP 0x80500000
DEFINE UART_BASE 0x10000000
DEFINE UART_LSR 0x10000005
DEFINE UART_LSR_DATA_READY 0x1
DEFINE UART_LSR_THR_EMPTY 0x20
DEFINE TEST_FINISHER_BASE 0x100000
DEFINE TEST_FINISHER_PASS 0x5555
DEFINE TEST_FINISHER_FAIL 0x3333
DEFINE LABEL_COUNT_PTR 0x80100000
DEFINE DEFINE_COUNT_PTR 0x80100004
DEFINE FAIL_LINE_PTR 0x80100008
DEFINE FAIL_PHASE_PTR 0x8010000C
DEFINE FAIL_STAGE_PTR 0x80100010
DEFINE LABELS_BASE 0x80100100
DEFINE DEFINES_BASE 0x80109000
DEFINE LINE_BASE 0x8010C000
DEFINE TOKEN_PTRS_BASE 0x8010C100
DEFINE LABEL_MAX 0x200
DEFINE LABEL_NAME_MAX 0x40
DEFINE LABEL_ENTRY_SIZE 0x44
DEFINE DEFINE_MAX 0x80
DEFINE DEFINE_ENTRY_SIZE 0x48
DEFINE LINE_MAX 0x100
DEFINE TOKEN_MAX 0x6
DEFINE RV_MATCH_ADD 0x33
DEFINE RV_MATCH_ADDI 0x13
DEFINE RV_MATCH_ANDI 0x7013
DEFINE RV_MATCH_AND 0x7033
DEFINE RV_MATCH_AUIPC 0x17
DEFINE RV_MATCH_BGE 0x5063
DEFINE RV_MATCH_BGEU 0x7063
DEFINE RV_MATCH_BLT 0x4063
DEFINE RV_MATCH_BLTU 0x6063
DEFINE RV_MATCH_BEQ 0x63
DEFINE RV_MATCH_BNE 0x1063
DEFINE RV_MATCH_EBREAK 0x100073
DEFINE RV_MATCH_ECALL 0x73
DEFINE RV_MATCH_FENCE 0xFF0000F
DEFINE RV_MATCH_FENCE_I 0x100F
DEFINE RV_MATCH_JAL 0x6F
DEFINE RV_MATCH_JALR 0x67
DEFINE RV_MATCH_LBU 0x4003
DEFINE RV_MATCH_LD 0x3003
DEFINE RV_MATCH_LUI 0x37
DEFINE RV_MATCH_LW 0x2003
DEFINE RV_MATCH_LWU 0x6003
DEFINE RV_MATCH_MUL 0x2000033
DEFINE RV_MATCH_OR 0x6033
DEFINE RV_MATCH_SB 0x23
DEFINE RV_MATCH_SD 0x3023
DEFINE RV_MATCH_SLLI 0x1013
DEFINE RV_MATCH_SLT 0x2033
DEFINE RV_MATCH_SLTIU 0x3013
DEFINE RV_MATCH_SLTU 0x3033
DEFINE RV_MATCH_SRLI 0x5013
DEFINE RV_MATCH_SUB 0x40000033
DEFINE RV_MATCH_SUBW 0x4000003B
DEFINE RV_MATCH_SW 0x2023
DEFINE RV_MATCH_XOR 0x4033
DEFINE RV_MATCH_XORI 0x4013
:_start
    ~stack_top_addr RD_T0 AUIPC  # addr stack_top_addr -> t0
    !stack_top_addr RD_T0 RS1_T0 ADDI
    RD_SP RS1_T0 LD  # u64 0(t0) -> sp
    ~read_source_from_uart RD_RA AUIPC  # call read_source_from_uart
    !read_source_from_uart RD_RA RS1_RA JALR
    @.Lboot_fail RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lboot_fail
    !-64 RD_SP RS1_SP ADDI  # sp += -64
    ~str_as0 RD_T0 AUIPC  # addr str_as0 -> t0
    !str_as0 RD_T0 RS1_T0 ADDI
    RS1_SP RS2_T0 SD  # u64 t0 -> 0(sp)
    ~source_base_addr RD_T0 AUIPC  # addr source_base_addr -> t0
    !source_base_addr RD_T0 RS1_T0 ADDI
    RD_T0 RS1_T0 LD  # u64 0(t0) -> t0
    @8 RS1_SP RS2_T0 SD  # u64 t0 -> 8(sp)
    ~raw_sink_begin_program RD_T0 AUIPC  # addr raw_sink_begin_program -> t0
    !raw_sink_begin_program RD_T0 RS1_T0 ADDI
    @0x10 RS1_SP RS2_T0 SD  # u64 t0 -> 16(sp)
    ~raw_sink_write_byte RD_T0 AUIPC  # addr raw_sink_write_byte -> t0
    !raw_sink_write_byte RD_T0 RS1_T0 ADDI
    @0x18 RS1_SP RS2_T0 SD  # u64 t0 -> 24(sp)
    ~raw_sink_end_program RD_T0 AUIPC  # addr raw_sink_end_program -> t0
    !raw_sink_end_program RD_T0 RS1_T0 ADDI
    @0x20 RS1_SP RS2_T0 SD  # u64 t0 -> 32(sp)
    @0x28 RS1_SP RS2_X0 SD  # u64 zero -> 40(sp)
    @0x30 RS1_SP RS2_X0 SW  # u32 zero -> 48(sp)
    @0x34 RS1_SP RS2_X0 SW  # u32 zero -> 52(sp)
    @0x38 RS1_SP RS2_X0 SW  # u32 zero -> 56(sp)
    RD_A0 RS1_SP MV  # sp -> a0
    !0x10 RD_A1 RS1_SP ADDI  # sp + 16 -> a1
    !0x30 RD_A2 RS1_SP ADDI  # sp + 48 -> a2
    ~compile_as0_program RD_RA AUIPC  # call compile_as0_program
    !compile_as0_program RD_RA RS1_RA JALR
    @.Lboot_fail_after_frame RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lboot_fail_after_frame
    !0x40 RD_SP RS1_SP ADDI  # sp += 64
    RD_A0 RS1_X0 ADDI  # 0 -> a0
    $system_exit RD_X0 JAL  # goto system_exit
:.Lboot_fail_after_frame
    !0x40 RD_SP RS1_SP ADDI  # sp += 64
:.Lboot_fail
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $system_exit RD_X0 JAL  # goto system_exit
:raw_sink_begin_program
    RETURN  # return
:raw_sink_write_byte
    ~0x10000005 RD_T0 LUI  # UART_LSR -> t0
    !0x10000005 RD_T0 RS1_T0 ADDIW
:.Lraw_sink_write_wait
    RD_T1 RS1_T0 LBU  # u8 0(t0) -> t1
    !0x20 RD_T1 RS1_T1 ANDI  # t1 & UART_LSR_THR_EMPTY -> t1
    @.Lraw_sink_write_wait RS1_T1 RS2_X0 BEQ  # if t1 == zero goto .Lraw_sink_write_wait
    ~0x10000000 RD_T0 LUI  # UART_BASE -> t0
    !0x10000000 RD_T0 RS1_T0 ADDIW
    RS1_T0 RS2_A1 SB  # u8 a1 -> 0(t0)
    RETURN  # return
:raw_sink_end_program
    RETURN  # return
:read_source_from_uart
    !-32 RD_SP RS1_SP ADDI  # sp += -32
    @0x18 RS1_SP RS2_RA SD  # u64 ra -> 24(sp)
    @0x10 RS1_SP RS2_S0 SD  # u64 s0 -> 16(sp)
    @8 RS1_SP RS2_S1 SD  # u64 s1 -> 8(sp)
    RS1_SP RS2_S2 SD  # u64 s2 -> 0(sp)
    ~source_base_addr RD_S0 AUIPC  # addr source_base_addr -> s0
    !source_base_addr RD_S0 RS1_S0 ADDI
    RD_S0 RS1_S0 LD  # u64 0(s0) -> s0
    ~0x1FFFF RD_S1 LUI  # SOURCE_MAX - 1 -> s1
    !0x1FFFF RD_S1 RS1_S1 ADDIW
    RD_S2 RS1_X0 ADDI  # 0 -> s2
:.Lread_source_loop
    ~uart_read RD_RA AUIPC  # call uart_read
    !uart_read RD_RA RS1_RA JALR
    !4 RD_T3 RS1_X0 ADDI  # 4 -> t3
    @.Lread_source_done RS1_A0 RS2_T3 BEQ  # if a0 == t3 goto .Lread_source_done
    @.Lread_source_fail RS1_S2 RS2_S1 BGEU  # if s2 >=u s1 goto .Lread_source_fail
    RS1_S0 RS2_A0 SB  # u8 a0 -> 0(s0)
    !1 RD_S0 RS1_S0 ADDI  # s0 + 1 -> s0
    !1 RD_S2 RS1_S2 ADDI  # s2 + 1 -> s2
    $.Lread_source_loop RD_X0 JAL  # goto .Lread_source_loop
:.Lread_source_done
    RS1_S0 RS2_X0 SB  # u8 zero -> 0(s0)
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Lread_source_return RD_X0 JAL  # goto .Lread_source_return
:.Lread_source_fail
    RD_A0 RS1_X0 ADDI  # 0 -> a0
:.Lread_source_return
    RD_S2 RS1_SP LD  # u64 0(sp) -> s2
    !8 RD_S1 RS1_SP LD  # u64 8(sp) -> s1
    !0x10 RD_S0 RS1_SP LD  # u64 16(sp) -> s0
    !0x18 RD_RA RS1_SP LD  # u64 24(sp) -> ra
    !0x20 RD_SP RS1_SP ADDI  # sp += 32
    RETURN  # return
:uart_read
    ~0x10000005 RD_T0 LUI  # UART_LSR -> t0
    !0x10000005 RD_T0 RS1_T0 ADDIW
:.Luart_read_wait
    RD_T1 RS1_T0 LBU  # u8 0(t0) -> t1
    !1 RD_T1 RS1_T1 ANDI  # t1 & UART_LSR_DATA_READY -> t1
    @.Luart_read_wait RS1_T1 RS2_X0 BEQ  # if t1 == zero goto .Luart_read_wait
    ~0x10000000 RD_T0 LUI  # UART_BASE -> t0
    !0x10000000 RD_T0 RS1_T0 ADDIW
    RD_A0 RS1_T0 LBU  # u8 0(t0) -> a0
    RETURN  # return
:system_exit
    ~0x100000 RD_T0 LUI  # TEST_FINISHER_BASE -> t0
    !0x100000 RD_T0 RS1_T0 ADDIW
    @.Lsystem_exit_pass RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lsystem_exit_pass
    !0x30 RD_A0 RS1_A0 SLLI  # a0 << 48 -> a0
    !0x30 RD_A0 RS1_A0 SRLI  # a0 >> 48 -> a0
    @.Lsystem_exit_fail_code_ok RS1_A0 RS2_X0 BNE  # if a0 != zero goto .Lsystem_exit_fail_code_ok
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
:.Lsystem_exit_fail_code_ok
    !0x10 RD_A0 RS1_A0 SLLI  # a0 << 16 -> a0
    ~0x3333 RD_T1 LUI  # TEST_FINISHER_FAIL -> t1
    !0x3333 RD_T1 RS1_T1 ADDIW
    RD_A0 RS1_A0 RS2_T1 OR  # a0 | t1 -> a0
    RS1_T0 RS2_A0 SW  # u32 a0 -> 0(t0)
:.Lsystem_exit_spin
    $.Lsystem_exit_spin RD_X0 JAL  # goto .Lsystem_exit_spin
:.Lsystem_exit_pass
    ~0x5555 RD_T1 LUI  # TEST_FINISHER_PASS -> t1
    !0x5555 RD_T1 RS1_T1 ADDIW
    RS1_T0 RS2_T1 SW  # u32 t1 -> 0(t0)
    $.Lsystem_exit_spin RD_X0 JAL  # goto .Lsystem_exit_spin
:compile_as0_program
    !-80 RD_SP RS1_SP ADDI  # sp += -80
    @0x48 RS1_SP RS2_RA SD  # u64 ra -> 72(sp)
    @0x40 RS1_SP RS2_S0 SD  # u64 s0 -> 64(sp)
    @0x38 RS1_SP RS2_S1 SD  # u64 s1 -> 56(sp)
    @0x30 RS1_SP RS2_S2 SD  # u64 s2 -> 48(sp)
    @0x28 RS1_SP RS2_S3 SD  # u64 s3 -> 40(sp)
    @0x20 RS1_SP RS2_S4 SD  # u64 s4 -> 32(sp)
    @0x18 RS1_SP RS2_S5 SD  # u64 s5 -> 24(sp)
    @0x10 RS1_SP RS2_S6 SD  # u64 s6 -> 16(sp)
    RD_S1 RS1_A1 MV  # a1 -> s1
    RD_S2 RS1_A2 MV  # a2 -> s2
    !8 RD_S0 RS1_A0 LD  # u64 8(a0) -> s0
    @8 RS1_SP RS2_A0 SD  # u64 a0 -> 8(sp)
    RD_T0 RS1_X0 ADDI  # 0 -> t0
    ~label_count_addr RD_T1 AUIPC  # addr label_count_addr -> t1
    !label_count_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~define_count_addr RD_T1 AUIPC  # addr define_count_addr -> t1
    !define_count_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    RS1_S2 RS2_T0 SW  # u32 t0 -> 0(s2)
    @4 RS1_S2 RS2_T0 SW  # u32 t0 -> 4(s2)
    @8 RS1_S2 RS2_T0 SW  # u32 t0 -> 8(s2)
    ~fail_line_addr RD_T1 AUIPC  # addr fail_line_addr -> t1
    !fail_line_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RS1_T1 RS2_X0 SW  # u32 zero -> 0(t1)
    ~fail_phase_addr RD_T1 AUIPC  # addr fail_phase_addr -> t1
    !fail_phase_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RS1_T1 RS2_X0 SW  # u32 zero -> 0(t1)
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RS1_T1 RS2_X0 SW  # u32 zero -> 0(t1)
    RD_S3 RS1_X0 ADDI  # 0 -> s3
:.Lpass1
    RD_T0 RS1_S0 LBU  # u8 0(s0) -> t0
    @.Lpass1_done RS1_T0 RS2_X0 BEQ  # if t0 == zero goto .Lpass1_done
    ~fail_line_addr RD_T1 AUIPC  # addr fail_line_addr -> t1
    !fail_line_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RD_T0 RS1_T1 LW  # i32 0(t1) -> t0
    !1 RD_T0 RS1_T0 ADDI  # t0 + 1 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~fail_phase_addr RD_T1 AUIPC  # addr fail_phase_addr -> t1
    !fail_phase_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !1 RD_T0 RS1_X0 ADDI  # 1 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !1 RD_T0 RS1_X0 ADDI  # 1 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    RD_A0 RS1_S0 MV  # s0 -> a0
    ~read_line RD_RA AUIPC  # call read_line
    !read_line RD_RA RS1_RA JALR
    @.Lfail RS1_A1 RS2_X0 BEQ  # if a1 == zero goto .Lfail
    RD_S0 RS1_A0 MV  # a0 -> s0
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !2 RD_T0 RS1_X0 ADDI  # 2 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~tokenize_line RD_RA AUIPC  # call tokenize_line
    !tokenize_line RD_RA RS1_RA JALR
    @.Lfail RS1_A0 RS2_X0 BLT  # if a0 < zero goto .Lfail
    @.Lpass1 RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lpass1
    RD_S4 RS1_A0 MV  # a0 -> s4
    RD_A0 RS1_X0 ADDI  # 0 -> a0
    ~token_ptr RD_RA AUIPC  # call token_ptr
    !token_ptr RD_RA RS1_RA JALR
    RD_S5 RS1_A0 MV  # a0 -> s5
    ~split_label RD_RA AUIPC  # call split_label
    !split_label RD_RA RS1_RA JALR
    @.Lpass1_not_label RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lpass1_not_label
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !3 RD_T0 RS1_X0 ADDI  # 3 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    RD_A0 RS1_S5 MV  # s5 -> a0
    RD_A1 RS1_S3 MV  # s3 -> a1
    ~add_label RD_RA AUIPC  # call add_label
    !add_label RD_RA RS1_RA JALR
    @.Lfail RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lfail
    $.Lpass1 RD_X0 JAL  # goto .Lpass1
:.Lpass1_not_label
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !4 RD_T0 RS1_X0 ADDI  # 4 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~line_size RD_RA AUIPC  # call line_size
    !line_size RD_RA RS1_RA JALR
    @.Lfail RS1_A0 RS2_X0 BLT  # if a0 < zero goto .Lfail
    RD_S3 RS1_S3 RS2_A0 ADD  # s3 + a0 -> s3
    $.Lpass1 RD_X0 JAL  # goto .Lpass1
:.Lpass1_done
    !8 RD_T0 RS1_SP LD  # u64 8(sp) -> t0
    !8 RD_S0 RS1_T0 LD  # u64 8(t0) -> s0
    RD_S3 RS1_X0 ADDI  # 0 -> s3
    ~fail_line_addr RD_T1 AUIPC  # addr fail_line_addr -> t1
    !fail_line_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RS1_T1 RS2_X0 SW  # u32 zero -> 0(t1)
    ~fail_phase_addr RD_T1 AUIPC  # addr fail_phase_addr -> t1
    !fail_phase_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !2 RD_T0 RS1_X0 ADDI  # 2 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RS1_T1 RS2_X0 SW  # u32 zero -> 0(t1)
    RD_A5 RS1_S1 LD  # u64 0(s1) -> a5
    !8 RD_A0 RS1_SP LD  # u64 8(sp) -> a0
    RD_A1 RS1_A0 LD  # u64 0(a0) -> a1
    RD_A0 RS1_S1 MV  # s1 -> a0
    RD_RA RS1_A5 JALR  # goto *a5
:.Lpass2
    RD_T0 RS1_S0 LBU  # u8 0(s0) -> t0
    @.Lpass2_done RS1_T0 RS2_X0 BEQ  # if t0 == zero goto .Lpass2_done
    ~fail_line_addr RD_T1 AUIPC  # addr fail_line_addr -> t1
    !fail_line_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    RD_T0 RS1_T1 LW  # i32 0(t1) -> t0
    !1 RD_T0 RS1_T0 ADDI  # t0 + 1 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !5 RD_T0 RS1_X0 ADDI  # 5 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    RD_A0 RS1_S0 MV  # s0 -> a0
    ~read_line RD_RA AUIPC  # call read_line
    !read_line RD_RA RS1_RA JALR
    @.Lfail_after_begin RS1_A1 RS2_X0 BEQ  # if a1 == zero goto .Lfail_after_begin
    RD_S0 RS1_A0 MV  # a0 -> s0
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !6 RD_T0 RS1_X0 ADDI  # 6 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~tokenize_line RD_RA AUIPC  # call tokenize_line
    !tokenize_line RD_RA RS1_RA JALR
    @.Lfail_after_begin RS1_A0 RS2_X0 BLT  # if a0 < zero goto .Lfail_after_begin
    @.Lpass2 RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lpass2
    RD_S4 RS1_A0 MV  # a0 -> s4
    RD_A0 RS1_X0 ADDI  # 0 -> a0
    ~token_ptr RD_RA AUIPC  # call token_ptr
    !token_ptr RD_RA RS1_RA JALR
    RD_S5 RS1_A0 MV  # a0 -> s5
    ~split_label RD_RA AUIPC  # call split_label
    !split_label RD_RA RS1_RA JALR
    @.Lpass2 RS1_A0 RS2_X0 BNE  # if a0 != zero goto .Lpass2
    ~fail_stage_addr RD_T1 AUIPC  # addr fail_stage_addr -> t1
    !fail_stage_addr RD_T1 RS1_T1 ADDI
    RD_T1 RS1_T1 LD  # u64 0(t1) -> t1
    !7 RD_T0 RS1_X0 ADDI  # 7 -> t0
    RS1_T1 RS2_T0 SW  # u32 t0 -> 0(t1)
    ~emit_line RD_RA AUIPC  # call emit_line
    !emit_line RD_RA RS1_RA JALR
    @.Lfail_after_begin RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lfail_after_begin
    $.Lpass2 RD_X0 JAL  # goto .Lpass2
:.Lpass2_done
    @4 RS1_S2 RS2_S3 SW  # u32 s3 -> 4(s2)
    !2 RD_T0 RS1_S3 SRLI  # s3 >> 2 -> t0
    RS1_S2 RS2_T0 SW  # u32 t0 -> 0(s2)
    @8 RS1_S2 RS2_X0 SW  # u32 zero -> 8(s2)
    !0x10 RD_A5 RS1_S1 LD  # u64 16(s1) -> a5
    !8 RD_T0 RS1_SP LD  # u64 8(sp) -> t0
    RD_A1 RS1_T0 LD  # u64 0(t0) -> a1
    RD_A0 RS1_S1 MV  # s1 -> a0
    RD_A2 RS1_S2 MV  # s2 -> a2
    RD_RA RS1_A5 JALR  # goto *a5
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Ldone RD_X0 JAL  # goto .Ldone
:.Lfail_after_begin
    ~debug_fail RD_RA AUIPC  # call debug_fail
    !debug_fail RD_RA RS1_RA JALR
    RD_A0 RS1_X0 ADDI  # 0 -> a0
