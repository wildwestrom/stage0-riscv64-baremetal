    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Lparse_register_done RD_X0 JAL  # goto .Lparse_register_done
:.Lreg_fp
    !8 RD_A1 RS1_X0 ADDI  # 8 -> a1
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Lparse_register_done RD_X0 JAL  # goto .Lparse_register_done
:.Lreg_t
    !1 RD_T0 RS1_A0 LBU  # u8 1(a0) -> t0
    !-48 RD_T0 RS1_T0 ADDI  # t0 + -'0' -> t0
    !7 RD_T1 RS1_X0 ADDI  # 7 -> t1
    @.Lreg_fail RS1_T0 RS2_T1 BGEU  # if t0 >=u t1 goto .Lreg_fail
    !2 RD_T1 RS1_A0 LBU  # u8 2(a0) -> t1
    @.Lreg_fail RS1_T1 RS2_X0 BNE  # if t1 != zero goto .Lreg_fail
    !3 RD_T1 RS1_X0 ADDI  # 3 -> t1
    @.Lreg_t_low RS1_T0 RS2_T1 BLTU  # if t0 <u t1 goto .Lreg_t_low
    !0x19 RD_A1 RS1_T0 ADDI  # t0 + 25 -> a1
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Lparse_register_done RD_X0 JAL  # goto .Lparse_register_done
:.Lreg_t_low
    !5 RD_A1 RS1_T0 ADDI  # t0 + 5 -> a1
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Lparse_register_done RD_X0 JAL  # goto .Lparse_register_done
:.Lreg_a
    !1 RD_T0 RS1_A0 LBU  # u8 1(a0) -> t0
    !-48 RD_T0 RS1_T0 ADDI  # t0 + -'0' -> t0
    !8 RD_T1 RS1_X0 ADDI  # 8 -> t1
    @.Lreg_fail RS1_T0 RS2_T1 BGEU  # if t0 >=u t1 goto .Lreg_fail
    !2 RD_T1 RS1_A0 LBU  # u8 2(a0) -> t1
    @.Lreg_fail RS1_T1 RS2_X0 BNE  # if t1 != zero goto .Lreg_fail
    !0xA RD_A1 RS1_T0 ADDI  # t0 + 10 -> a1
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Lparse_register_done RD_X0 JAL  # goto .Lparse_register_done
:.Lreg_s
    !1 RD_A0 RS1_A0 ADDI  # a0 + 1 -> a0
    ~parse_number RD_RA AUIPC  # call parse_number
    !parse_number RD_RA RS1_RA JALR
    @.Lreg_fail RS1_A0 RS2_X0 BEQ  # if a0 == zero goto .Lreg_fail
    !2 RD_T0 RS1_X0 ADDI  # 2 -> t0
    @.Lreg_s_low RS1_A1 RS2_T0 BLTU  # if a1 <u t0 goto .Lreg_s_low
    !0xC RD_T0 RS1_X0 ADDI  # 12 -> t0
    @.Lreg_fail RS1_A1 RS2_T0 BGEU  # if a1 >=u t0 goto .Lreg_fail
    !0x10 RD_A1 RS1_A1 ADDI  # a1 + 16 -> a1
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Lparse_register_done RD_X0 JAL  # goto .Lparse_register_done
:.Lreg_s_low
    !8 RD_A1 RS1_A1 ADDI  # a1 + 8 -> a1
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    $.Lparse_register_done RD_X0 JAL  # goto .Lparse_register_done
:.Lreg_fail
    RD_A0 RS1_X0 ADDI  # 0 -> a0
:.Lparse_register_done
    !8 RD_RA RS1_SP LD  # u64 8(sp) -> ra
    !0x10 RD_SP RS1_SP ADDI  # sp += 16
    RETURN  # return
:parse_number
    RD_T0 RS1_X0 ADDI  # 0 -> t0
    !1 RD_T1 RS1_X0 ADDI  # 1 -> t1
    RD_T2 RS1_A0 LBU  # u8 0(a0) -> t2
    !0x2D RD_T3 RS1_X0 ADDI  # '-' -> t3
    @.Lpn_prefix_check RS1_T2 RS2_T3 BNE  # if t2 != t3 goto .Lpn_prefix_check
    !-1 RD_T1 RS1_X0 ADDI  # -1 -> t1
    !1 RD_A0 RS1_A0 ADDI  # a0 + 1 -> a0
:.Lpn_prefix_check
    RD_T2 RS1_A0 LBU  # u8 0(a0) -> t2
    !0x30 RD_T3 RS1_X0 ADDI  # '0' -> t3
    @.Lpn_dec_loop RS1_T2 RS2_T3 BNE  # if t2 != t3 goto .Lpn_dec_loop
    !1 RD_T4 RS1_A0 LBU  # u8 1(a0) -> t4
    !0x78 RD_T5 RS1_X0 ADDI  # 'x' -> t5
    @.Lpn_hex_start RS1_T4 RS2_T5 BEQ  # if t4 == t5 goto .Lpn_hex_start
    !0x58 RD_T5 RS1_X0 ADDI  # 'X' -> t5
    @.Lpn_hex_start RS1_T4 RS2_T5 BEQ  # if t4 == t5 goto .Lpn_hex_start
:.Lpn_dec_loop
:.Lpn_loop_dec_body
    RD_T2 RS1_A0 LBU  # u8 0(a0) -> t2
    @.Lpn_done RS1_T2 RS2_X0 BEQ  # if t2 == zero goto .Lpn_done
    !-48 RD_T2 RS1_T2 ADDI  # t2 + -'0' -> t2
    !0xA RD_T3 RS1_X0 ADDI  # 10 -> t3
    @.Lpn_fail RS1_T2 RS2_T3 BGEU  # if t2 >=u t3 goto .Lpn_fail
    !0xA RD_T3 RS1_X0 ADDI  # 10 -> t3
    RD_T0 RS1_T0 RS2_T3 MUL  # t0 * t3 -> t0
    RD_T0 RS1_T0 RS2_T2 ADD  # t0 + t2 -> t0
    !1 RD_A0 RS1_A0 ADDI  # a0 + 1 -> a0
    $.Lpn_loop_dec_body RD_X0 JAL  # goto .Lpn_loop_dec_body
:.Lpn_hex_start
    !2 RD_A0 RS1_A0 ADDI  # a0 + 2 -> a0
:.Lpn_hex_loop
    RD_T2 RS1_A0 LBU  # u8 0(a0) -> t2
    @.Lpn_done RS1_T2 RS2_X0 BEQ  # if t2 == zero goto .Lpn_done
    !0x30 RD_T3 RS1_X0 ADDI  # '0' -> t3
    @.Lpn_fail RS1_T2 RS2_T3 BLTU  # if t2 <u t3 goto .Lpn_fail
    !0x39 RD_T3 RS1_X0 ADDI  # '9' -> t3
    @.Lpn_hex_digit RS1_T3 RS2_T2 BGEU  # if t2 <=u t3 goto .Lpn_hex_digit
    !0x61 RD_T3 RS1_X0 ADDI  # 'a' -> t3
    @.Lpn_hex_upper_check RS1_T2 RS2_T3 BLTU  # if t2 <u t3 goto .Lpn_hex_upper_check
    !0x66 RD_T3 RS1_X0 ADDI  # 'f' -> t3
    @.Lpn_hex_lower RS1_T3 RS2_T2 BGEU  # if t2 <=u t3 goto .Lpn_hex_lower
:.Lpn_hex_upper_check
    !0x41 RD_T3 RS1_X0 ADDI  # 'A' -> t3
    @.Lpn_fail RS1_T2 RS2_T3 BLTU  # if t2 <u t3 goto .Lpn_fail
    !0x46 RD_T3 RS1_X0 ADDI  # 'F' -> t3
    @.Lpn_fail RS1_T3 RS2_T2 BLTU  # if t2 >u t3 goto .Lpn_fail
    !-65 RD_T2 RS1_T2 ADDI  # t2 + -'A' -> t2
    !0xA RD_T2 RS1_T2 ADDI  # t2 + 10 -> t2
    $.Lpn_hex_accum RD_X0 JAL  # goto .Lpn_hex_accum
:.Lpn_hex_lower
    !-97 RD_T2 RS1_T2 ADDI  # t2 + -'a' -> t2
    !0xA RD_T2 RS1_T2 ADDI  # t2 + 10 -> t2
    $.Lpn_hex_accum RD_X0 JAL  # goto .Lpn_hex_accum
:.Lpn_hex_digit
    !-48 RD_T2 RS1_T2 ADDI  # t2 + -'0' -> t2
:.Lpn_hex_accum
    !4 RD_T0 RS1_T0 SLLI  # t0 << 4 -> t0
    RD_T0 RS1_T0 RS2_T2 ADD  # t0 + t2 -> t0
    !1 RD_A0 RS1_A0 ADDI  # a0 + 1 -> a0
    $.Lpn_hex_loop RD_X0 JAL  # goto .Lpn_hex_loop
:.Lpn_done
    RD_A1 RS1_T0 RS2_T1 MUL  # t0 * t1 -> a1
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    RETURN  # return
:.Lpn_fail
    RD_A0 RS1_X0 ADDI  # 0 -> a0
    RETURN  # return
