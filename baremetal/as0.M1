    RD_A0 RS1_T0 LD  # u64 0(t0) -> a0
    RETURN  # return
:split_label
    RD_T0 RS1_A0 MV  # a0 -> t0
:.Lsplit_scan
    RD_T1 RS1_T0 LBU  # u8 0(t0) -> t1
    @.Lsplit_no RS1_T1 RS2_X0 BEQ  # if t1 == zero goto .Lsplit_no
    !0x3A RD_T2 RS1_X0 ADDI  # ':' -> t2
    @.Lsplit_yes RS1_T1 RS2_T2 BEQ  # if t1 == t2 goto .Lsplit_yes
    !1 RD_T0 RS1_T0 ADDI  # t0 + 1 -> t0
    $.Lsplit_scan RD_X0 JAL  # goto .Lsplit_scan
:.Lsplit_yes
    !1 RD_T1 RS1_T0 LBU  # u8 1(t0) -> t1
    @.Lsplit_no RS1_T1 RS2_X0 BNE  # if t1 != zero goto .Lsplit_no
    RS1_T0 RS2_X0 SB  # u8 zero -> 0(t0)
    !1 RD_A0 RS1_X0 ADDI  # 1 -> a0
    RETURN  # return
:.Lsplit_no
    RD_A0 RS1_X0 ADDI  # 0 -> a0
    RETURN  # return
