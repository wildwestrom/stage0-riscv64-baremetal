    # $backend_First_pass_loop JAL ; return
    $backend_First_pass_loop 6F000000
:backend_write_byte
    # RS1_A7 RS2_A0 SB ; Write byte to output buffer
    .00800800 .0000A000 23000000
    # RD_A7 RS1_A7 !1 ADDI ; Advance output pointer
    .80080000 .00800800 .00001000 13000000
    # RS1_RA JALR ; return
    .00800000 67000000
:backend_Fail
    # $backend_Fail JAL ; Halt (infinite loop) - indicates an error
    $backend_Fail 6F000000
