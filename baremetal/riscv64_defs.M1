;; ============================================================================
;; CHERI-RISC-V Extensions (ISA v9)
;; All CHERI instructions use major opcode 0x5b.
;; Encodings are 32-bit little-endian hex with register fields zeroed.
;; Reference: CHERI ISA v9, Appendix B
;; ============================================================================

;; --------------------------------------------------------------------------
;; CHERI Capability Register ABI Names
;; Capability registers c0-c31 share the same physical register file as x0-x31.
;; These are re-exports of RD_X*/RS1_X*/RS2_X* with CHERI ABI names.
;; Reference: CHERI ISA v9, Appendix B.3.1
;; --------------------------------------------------------------------------

;; Capability destination registers (cd) — same encoding as rd
;; register_number << 7
DEFINE CRD_CNULL .00000000   # c0  = x0
DEFINE CRD_CRA   .80000000   # c1  = x1
DEFINE CRD_CSP   .00010000   # c2  = x2
DEFINE CRD_CGP   .80010000   # c3  = x3
DEFINE CRD_CTP   .00020000   # c4  = x4
DEFINE CRD_CT0   .80020000   # c5  = x5
DEFINE CRD_CT1   .00030000   # c6  = x6
DEFINE CRD_CT2   .80030000   # c7  = x7
DEFINE CRD_CS0   .00040000   # c8  = x8
DEFINE CRD_CFP   .00040000   # c8  = x8 (frame pointer alias)
DEFINE CRD_CS1   .80040000   # c9  = x9
DEFINE CRD_CA0   .00050000   # c10 = x10
DEFINE CRD_CA1   .80050000   # c11 = x11
DEFINE CRD_CA2   .00060000   # c12 = x12
DEFINE CRD_CA3   .80060000   # c13 = x13
DEFINE CRD_CA4   .00070000   # c14 = x14
DEFINE CRD_CA5   .80070000   # c15 = x15
DEFINE CRD_CA6   .00080000   # c16 = x16
DEFINE CRD_CA7   .80080000   # c17 = x17
DEFINE CRD_CS2   .00090000   # c18 = x18
DEFINE CRD_CS3   .80090000   # c19 = x19
DEFINE CRD_CS4   .000A0000   # c20 = x20
DEFINE CRD_CS5   .800A0000   # c21 = x21
DEFINE CRD_CS6   .000B0000   # c22 = x22
DEFINE CRD_CS7   .800B0000   # c23 = x23
DEFINE CRD_CS8   .000C0000   # c24 = x24
DEFINE CRD_CS9   .800C0000   # c25 = x25
DEFINE CRD_CS10  .000D0000   # c26 = x26
DEFINE CRD_CS11  .800D0000   # c27 = x27
DEFINE CRD_CT3   .000E0000   # c28 = x28
DEFINE CRD_CT4   .800E0000   # c29 = x29
DEFINE CRD_CT5   .000F0000   # c30 = x30
DEFINE CRD_CT6   .800F0000   # c31 = x31

;; Capability first source registers (cs1) — same encoding as rs1
;; register_number << 15
DEFINE CRS1_CNULL .00000000   # c0  = x0
DEFINE CRS1_CRA   .00800000   # c1  = x1
DEFINE CRS1_CSP   .00000100   # c2  = x2
DEFINE CRS1_CGP   .00800100   # c3  = x3
DEFINE CRS1_CTP   .00000200   # c4  = x4
DEFINE CRS1_CT0   .00800200   # c5  = x5
DEFINE CRS1_CT1   .00000300   # c6  = x6
DEFINE CRS1_CT2   .00800300   # c7  = x7
DEFINE CRS1_CS0   .00000400   # c8  = x8
DEFINE CRS1_CFP   .00000400   # c8  = x8 (frame pointer alias)
DEFINE CRS1_CS1   .00800400   # c9  = x9
DEFINE CRS1_CA0   .00000500   # c10 = x10
DEFINE CRS1_CA1   .00800500   # c11 = x11
DEFINE CRS1_CA2   .00000600   # c12 = x12
DEFINE CRS1_CA3   .00800600   # c13 = x13
DEFINE CRS1_CA4   .00000700   # c14 = x14
DEFINE CRS1_CA5   .00800700   # c15 = x15
DEFINE CRS1_CA6   .00000800   # c16 = x16
DEFINE CRS1_CA7   .00800800   # c17 = x17
DEFINE CRS1_CS2   .00000900   # c18 = x18
DEFINE CRS1_CS3   .00800900   # c19 = x19
DEFINE CRS1_CS4   .00000A00   # c20 = x20
DEFINE CRS1_CS5   .00800A00   # c21 = x21
DEFINE CRS1_CS6   .00000B00   # c22 = x22
DEFINE CRS1_CS7   .00800B00   # c23 = x23
DEFINE CRS1_CS8   .00000C00   # c24 = x24
DEFINE CRS1_CS9   .00800C00   # c25 = x25
DEFINE CRS1_CS10  .00000D00   # c26 = x26
DEFINE CRS1_CS11  .00800D00   # c27 = x27
DEFINE CRS1_CT3   .00000E00   # c28 = x28
DEFINE CRS1_CT4   .00800E00   # c29 = x29
DEFINE CRS1_CT5   .00000F00   # c30 = x30
DEFINE CRS1_CT6   .00800F00   # c31 = x31

;; Capability second source registers (cs2) — same encoding as rs2
;; register_number << 20
DEFINE CRS2_CNULL .00000000   # c0  = x0
DEFINE CRS2_CRA   .00001000   # c1  = x1
DEFINE CRS2_CSP   .00002000   # c2  = x2
DEFINE CRS2_CGP   .00003000   # c3  = x3
DEFINE CRS2_CTP   .00004000   # c4  = x4
DEFINE CRS2_CT0   .00005000   # c5  = x5
DEFINE CRS2_CT1   .00006000   # c6  = x6
DEFINE CRS2_CT2   .00007000   # c7  = x7
DEFINE CRS2_CS0   .00008000   # c8  = x8
DEFINE CRS2_CFP   .00008000   # c8  = x8 (frame pointer alias)
DEFINE CRS2_CS1   .00009000   # c9  = x9
DEFINE CRS2_CA0   .0000A000   # c10 = x10
DEFINE CRS2_CA1   .0000B000   # c11 = x11
DEFINE CRS2_CA2   .0000C000   # c12 = x12
DEFINE CRS2_CA3   .0000D000   # c13 = x13
DEFINE CRS2_CA4   .0000E000   # c14 = x14
DEFINE CRS2_CA5   .0000F000   # c15 = x15
DEFINE CRS2_CA6   .00000001   # c16 = x16
DEFINE CRS2_CA7   .00001001   # c17 = x17
DEFINE CRS2_CS2   .00002001   # c18 = x18
DEFINE CRS2_CS3   .00003001   # c19 = x19
DEFINE CRS2_CS4   .00004001   # c20 = x20
DEFINE CRS2_CS5   .00005001   # c21 = x21
DEFINE CRS2_CS6   .00006001   # c22 = x22
DEFINE CRS2_CS7   .00007001   # c23 = x23
DEFINE CRS2_CS8   .00008001   # c24 = x24
DEFINE CRS2_CS9   .00009001   # c25 = x25
DEFINE CRS2_CS10  .0000A001   # c26 = x26
DEFINE CRS2_CS11  .0000B001   # c27 = x27
DEFINE CRS2_CT3   .0000C001   # c28 = x28
DEFINE CRS2_CT4   .0000D001   # c29 = x29
DEFINE CRS2_CT5   .0000E001   # c30 = x30
DEFINE CRS2_CT6   .0000F001   # c31 = x31

;; --------------------------------------------------------------------------
;; CHERI Instruction Opcodes
;; All use major opcode 0x5b. Encoding: (funct7 << 25) | (rs2 << 20) | opcode
;; Format: little-endian hex with rd=0, rs1=0, rs2=0 (unless fixed by spec)
;; --------------------------------------------------------------------------

;; Capability Inspection — R-type, funct7=0x7f, sub-function in rs2 field
;; Format: 0x7f | rs2 | cs1 | 0x0 | cd | 0x5b
DEFINE CGETPERM    5B0000FE   # funct7=0x7f, rs2=0x00 — rd ← perm(cs1)
DEFINE CGETTYPE    5B0010FE   # funct7=0x7f, rs2=0x01 — rd ← otype(cs1)
DEFINE CGETBASE    5B0020FE   # funct7=0x7f, rs2=0x02 — rd ← base(cs1)
DEFINE CGETLEN     5B0030FE   # funct7=0x7f, rs2=0x03 — rd ← length(cs1)
DEFINE CGETTAG     5B0040FE   # funct7=0x7f, rs2=0x04 — rd ← tag(cs1)
DEFINE CGETSEALED  5B0050FE   # funct7=0x7f, rs2=0x05 — rd ← sealed(cs1)
DEFINE CGETOFFSET  5B0060FE   # funct7=0x7f, rs2=0x06 — rd ← offset(cs1)
DEFINE CGETFLAGS   5B0070FE   # funct7=0x7f, rs2=0x07 — rd ← flags(cs1)
DEFINE CGETHIGH    5B0070FF   # funct7=0x7f, rs2=0x17 — rd ← high(cs1)
DEFINE CGETTOP     5B0080FF   # funct7=0x7f, rs2=0x18 — rd ← top(cs1)

;; Precision — R-type, funct7=0x7f, sub-function in rs2 field
DEFINE CRRL        5B0080FE   # funct7=0x7f, rs2=0x08 — CRoundRepresentableLength
DEFINE CRAM        5B0090FE   # funct7=0x7f, rs2=0x09 — CRepresentableAlignmentMask

;; Capability Modification — R-type, two sources + dest
;; Format: funct7 | cs2 | cs1 | 0x0 | cd | 0x5b
DEFINE CSETBOUNDS      5B000010   # funct7=0x08 — cd ← setBounds(cs1, rs2)
DEFINE CSETBOUNDSEXACT  5B000012   # funct7=0x09 — cd ← setBoundsExact(cs1, rs2)
DEFINE CSEAL           5B000016   # funct7=0x0b — cd ← seal(cs1, cs2)
DEFINE CUNSEAL         5B000018   # funct7=0x0c — cd ← unseal(cs1, cs2)
DEFINE CANDPERM        5B00001A   # funct7=0x0d — cd ← andPerm(cs1, rs2)
DEFINE CSETFLAGS       5B00001C   # funct7=0x0e — cd ← setFlags(cs1, rs2)
DEFINE CSETOFFSET      5B00001E   # funct7=0x0f — cd ← setOffset(cs1, rs2)
DEFINE CSETADDR        5B000020   # funct7=0x10 — cd ← setAddr(cs1, rs2)
DEFINE CINCOFFSET      5B000022   # funct7=0x11 — cd ← incOffset(cs1, rs2)
DEFINE CSETHIGH        5B00002C   # funct7=0x16 — cd ← setHigh(cs1, rs2)
DEFINE CBUILDCAP       5B00003A   # funct7=0x1d — cd ← buildCap(cs1, cs2)
DEFINE CCOPYTYPE       5B00003C   # funct7=0x1e — cd ← copyType(cs1, cs2)
DEFINE CCCSEAL         5B00003E   # funct7=0x1f — cd ← condSeal(cs1, cs2)

;; Capability Modification — funct7=0x7f, sub-function in rs2 field (single source)
DEFINE CMOVE           5B00A0FE   # funct7=0x7f, rs2=0x0a — cd ← cs1
DEFINE CCLEARTAG       5B00B0FE   # funct7=0x7f, rs2=0x0b — cd ← clearTag(cs1)
DEFINE CSEALENTRY      5B0010FF   # funct7=0x7f, rs2=0x11 — cd ← sealEntry(cs1)

;; Pointer Arithmetic — R-type
DEFINE CTOPTR          5B000024   # funct7=0x12 — rd ← toPtr(cs1, cs2)
DEFINE CFROMPTR        5B000026   # funct7=0x13 — cd ← fromPtr(cs1, rs2)
DEFINE CSUB            5B000028   # funct7=0x14 — rd ← cs1 - cs2

;; Pointer Comparison — R-type
DEFINE CTESTSUBSET     5B000040   # funct7=0x20 — rd ← testSubset(cs1, cs2)
DEFINE CSETEQUALEXACT  5B000042   # funct7=0x21 — rd ← setEqualExact(cs1, cs2)

;; Control Flow
DEFINE JALR_CAP        5B00C0FE   # funct7=0x7f, rs2=0x0c — jump via capability
DEFINE JALR_PCC        5B0040FF   # funct7=0x7f, rs2=0x14 — jump via PCC-relative
DEFINE CINVOKE         DB0000FC   # funct7=0x7e, rd=0x01 (fixed) — CInvoke cs1, cs2

;; Special Register Access — R-type
DEFINE CSPECIALRW      5B000002   # funct7=0x01 — cd ← special[rs2]; special[rs2] ← cs1

;; Register Clearing
DEFINE CCLEAR          5B00E0FE   # funct7=0x7f, rs2=0x0e — clear int reg quarter
DEFINE FPCLEAR         5B0000FF   # funct7=0x7f, rs2=0x10 — clear FP reg quarter

;; Tag Memory
DEFINE CLOADTAGS       5B0020FF   # funct7=0x7f, rs2=0x12 — rd ← loadTags(cs1)
DEFINE CCLEARTAGS      DB0F00FC   # funct7=0x7e, rs2=0x00, rd=0x1f (fixed) — clearTags

;; I-type CHERI instructions (immediate in bits[31:20])
;; Format: imm[11:0] | cs1 | funct3 | cd | 0x5b
DEFINE CINCOFFSETIMM   5B100000   # funct3=0x1 — cd ← incOffset(cs1, imm)
DEFINE CSETBOUNDSIMM   5B200000   # funct3=0x2 — cd ← setBounds(cs1, imm)

;; --------------------------------------------------------------------------
;; CHERI Explicit Address-Type Load/Store Instructions
;; DDC-relative (via default data capability) and CAP-relative (via cs1)
;; --------------------------------------------------------------------------

;; DDC-relative Loads — funct7=0x7d, width in rs2 field
;; Format: 0x7d | rs2(width) | rs1/cs1 | 0x0 | rd/cd | 0x5b
DEFINE LB_DDC    5B0000FA   # funct7=0x7d, rs2=0x00 — load byte
DEFINE LH_DDC    5B0010FA   # funct7=0x7d, rs2=0x01 — load halfword
DEFINE LW_DDC    5B0020FA   # funct7=0x7d, rs2=0x02 — load word
DEFINE LD_DDC    5B0030FA   # funct7=0x7d, rs2=0x03 — load doubleword
DEFINE LBU_DDC   5B0040FA   # funct7=0x7d, rs2=0x04 — load byte unsigned
DEFINE LHU_DDC   5B0050FA   # funct7=0x7d, rs2=0x05 — load halfword unsigned
DEFINE LWU_DDC   5B0060FA   # funct7=0x7d, rs2=0x06 — load word unsigned
DEFINE LC_DDC    5B0070FB   # funct7=0x7d, rs2=0x17 — load capability (RV64)

;; CAP-relative Loads — funct7=0x7d, width in rs2 field (DDC bit + width)
DEFINE LB_CAP    5B0080FA   # funct7=0x7d, rs2=0x08 — load byte
DEFINE LH_CAP    5B0090FA   # funct7=0x7d, rs2=0x09 — load halfword
DEFINE LW_CAP    5B00A0FA   # funct7=0x7d, rs2=0x0a — load word
DEFINE LD_CAP    5B00B0FA   # funct7=0x7d, rs2=0x0b — load doubleword
DEFINE LBU_CAP   5B00C0FA   # funct7=0x7d, rs2=0x0c — load byte unsigned
DEFINE LHU_CAP   5B00D0FA   # funct7=0x7d, rs2=0x0d — load halfword unsigned
DEFINE LWU_CAP   5B00E0FA   # funct7=0x7d, rs2=0x0e — load word unsigned
DEFINE LC_CAP    5B00F0FB   # funct7=0x7d, rs2=0x1f — load capability (RV64)

;; DDC-relative Stores — funct7=0x7c, width in rd field
;; Format: 0x7c | cs2/rs2 | rs1/cs1 | 0x0 | rd(width) | 0x5b
DEFINE SB_DDC    5B0000F8   # funct7=0x7c, rd=0x00 — store byte
DEFINE SH_DDC    DB0000F8   # funct7=0x7c, rd=0x01 — store halfword
DEFINE SW_DDC    5B0100F8   # funct7=0x7c, rd=0x02 — store word
DEFINE SD_DDC    DB0100F8   # funct7=0x7c, rd=0x03 — store doubleword
DEFINE SC_DDC    5B0200F8   # funct7=0x7c, rd=0x04 — store capability (RV64)

;; CAP-relative Stores — funct7=0x7c, width in rd field (CAP bit + width)
DEFINE SB_CAP    5B0400F8   # funct7=0x7c, rd=0x08 — store byte
DEFINE SH_CAP    DB0400F8   # funct7=0x7c, rd=0x09 — store halfword
DEFINE SW_CAP    5B0500F8   # funct7=0x7c, rd=0x0a — store word
DEFINE SD_CAP    DB0500F8   # funct7=0x7c, rd=0x0b — store doubleword
DEFINE SC_CAP    5B0600F8   # funct7=0x7c, rd=0x0c — store capability (RV64)

;; --------------------------------------------------------------------------
;; Capability Load/Store with offset (reuses anticipated RV128 LQ/SQ encodings)
;; These use standard I-type/S-type format with a 12-bit immediate offset.
;; --------------------------------------------------------------------------
DEFINE LC        0F200000   # opcode=0x0f, funct3=0x2 — load capability + offset
DEFINE SC        23400000   # opcode=0x23, funct3=0x4 — store capability + offset

;; --------------------------------------------------------------------------
;; CHERI Pseudoinstructions / Aliases
;; --------------------------------------------------------------------------
DEFINE AUIPCC    17000000   # Same encoding as AUIPC — capability mode alias
